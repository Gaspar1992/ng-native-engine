{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "defaultProject": "ng-linux-counter",
  "projects": {
    "ng-linux-counter": {
      "projectType": "application",
      "architect": {
        "build": {
          "builder": "@ng-native/builders:engine",
          "options": {
            "targetPlatform": "linux-gtk4",
            "outputPath": "dist/ng-linux-counter",
            "main": "src/main.ts"
          }
        }
      }
    }
  }
}
